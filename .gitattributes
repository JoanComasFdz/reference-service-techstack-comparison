# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.cs text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
Makefile text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
