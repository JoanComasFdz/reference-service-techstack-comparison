<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.abstractions" Version="2.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.1.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="RabbitMQ.Client" Version="7.0.0" />
  </ItemGroup>

  <!--
    IMPORTANT: This is the ONLY InternalsVisibleTo in the entire solution.

    Why this exception exists:
    - IntegrationTesting.Tests verifies the infrastructure implementation itself
    - Tests ContainerManager singleton pattern and EnsureStartedAsync idempotency
    - Requires access to internal ContainerManager.Instance and methods

    All OTHER integration test projects (EventPublishing, EventConsuming, etc.)
    MUST only use public APIs. They should NOT add InternalsVisibleTo.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="PerformanceTester.IntegrationTesting.Tests" />
  </ItemGroup>

</Project>
