# Performance Tester Environment Variables
#
# These environment variables configure the performance testing scripts for
# connecting to RabbitMQ, PostgreSQL containers, and monitoring infrastructure.
#
# Usage:
# 1. Copy this file to .env in the same directory
# 2. Modify values as needed for your environment
# 3. The scripts will automatically load these values
#
# Note: All variables have sensible defaults matching the docker-compose setup,
# so you only need to set these if you're using different configuration.

# ============================================================================
# RabbitMQ Configuration
# ============================================================================

# RabbitMQ connection details
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# RabbitMQ exchange and routing configuration
RABBITMQ_EXCHANGE=referenceservice.comparison
RABBITMQ_EVENT_TYPE=instrument.status.changed
RABBITMQ_CONSUME_EVENT_TYPE=instrumentstatus.kpi.updated

# RabbitMQ consumer configuration
RABBITMQ_CONSUMER_QUEUE=service-tester
RABBITMQ_PREFETCH_COUNT=100

# ============================================================================
# PostgreSQL Configuration (for run-all-tests.sh script)
# ============================================================================

# PostgreSQL credentials for database operations
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# ============================================================================
# Docker Container Names
# ============================================================================

# Docker container names for monitoring
# These should match the names in your docker-compose.yml
RABBITMQ_CONTAINER_NAME=performancetest-rabbitmq
POSTGRES_CONTAINER_NAME=performancetest-postgres

# RabbitMQ virtual host (used by run-all-tests.sh)
RABBITMQ_VHOST=/
