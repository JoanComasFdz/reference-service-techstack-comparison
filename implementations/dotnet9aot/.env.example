# .NET 9 AOT Reference Service Environment Variables
#
# Environment variables override values from appsettings.json
# Use double underscores (__) to represent nested configuration hierarchy
# Example: Postgres:Host becomes Postgres__Host

# PostgreSQL Database Configuration
Postgres__Host=localhost
Postgres__Port=5432
Postgres__Database=dotnet9aot_db
Postgres__Username=admin
Postgres__Password=admin

# Kestrel Web Server Configuration
Kestrel__Endpoints__Http__Url=http://localhost:8093

# RabbitMQ Configuration
RabbitMQ__Host=localhost
RabbitMQ__Port=5672
RabbitMQ__Username=admin
RabbitMQ__Password=admin

# RabbitMQ__PrefetchCount is configured in appsettings.json (default: 50)
# and should not be changed to maintain fair performance comparison across services
