# Database Configuration
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://admin:admin@localhost:5432/bun_db?schema=public"

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_PREFETCH_COUNT=1

# RabbitMQ Exchange and Queue Configuration
EXCHANGE_NAME=referenceservice.comparison
QUEUE_NAME=bun
ROUTING_KEY_STATUS_CHANGED=instrument.status.changed
ROUTING_KEY_KPI_UPDATED=instrumentstatus.kpi.updated

# HTTP Server Configuration
HTTP_PORT=8090
