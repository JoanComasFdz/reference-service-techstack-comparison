generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BunInstrumentStatus {
  id             Int      @id @default(autoincrement())
  deviceId       String   @map("device_id") @db.VarChar(255)
  previousStatus String   @map("previous_status") @db.VarChar(255)
  currentStatus  String   @map("current_status") @db.VarChar(255)
  timestamp      DateTime @db.Timestamptz()

  @@map("bun_instrument_status")
  @@index([timestamp(sort: Desc)], name: "idx_bun_instrument_status_timestamp")
}
