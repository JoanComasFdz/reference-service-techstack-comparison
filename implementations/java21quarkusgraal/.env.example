# PostgreSQL Database Configuration
# Database host (default: localhost)
POSTGRES_HOST=localhost
# Database port (default: 5432)
POSTGRES_PORT=5432
# Database name (default: java21quarkus_db)
POSTGRES_DB=java21quarkus_db
# Database username (default: admin)
POSTGRES_USER=admin
# Database password (default: admin)
POSTGRES_PASSWORD=admin

# RabbitMQ Message Broker Configuration
# RabbitMQ host (default: localhost)
RABBITMQ_HOST=localhost
# RabbitMQ port (default: 5672)
RABBITMQ_PORT=5672
# RabbitMQ username (default: admin)
RABBITMQ_USER=admin
# RabbitMQ password (default: admin)
RABBITMQ_PASSWORD=admin
