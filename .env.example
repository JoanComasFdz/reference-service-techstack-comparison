# ============================================================================
# Performance Testing Project - Master Environment Configuration
# ============================================================================
#
# This file provides a centralized configuration for all services and scripts.
# Copy this file to .env and modify as needed for your environment.
#
# Usage:
#   1. Copy: cp .env.example .env
#   2. Edit .env with your values
#   3. Source before running: source .env (or use direnv/dotenv tools)
#
# All variables have sensible defaults matching docker-compose.yml,
# so you only need to set these if using different infrastructure.

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================

# PostgreSQL connection details (used by all services)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Individual service database names (usually don't need to change)
# POSTGRES_DB=<service-specific> # Each service has its own default

# PostgreSQL Docker container name
POSTGRES_CONTAINER_NAME=performancetest-postgres

# ============================================================================
# RabbitMQ Message Broker Configuration
# ============================================================================

# RabbitMQ connection details (used by all services)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# RabbitMQ topology (usually don't need to change)
RABBITMQ_EXCHANGE=referenceservice.comparison
RABBITMQ_EVENT_TYPE=instrument.status.changed
RABBITMQ_CONSUME_EVENT_TYPE=instrumentstatus.kpi.updated

# RabbitMQ Docker container name
RABBITMQ_CONTAINER_NAME=performancetest-rabbitmq

# RabbitMQ virtual host (for management operations)
RABBITMQ_VHOST=/

# ============================================================================
# RabbitMQ Quality of Service (QoS) Settings
# ============================================================================

# Prefetch count for services (standardized for fair comparison)
# Do NOT change these unless you understand the performance implications
RABBITMQ_PREFETCH=50              # Used by Java Spring Boot services
RABBITMQ_PREFETCH_COUNT=50        # Used by .NET, Python, performance-tester
RABBITMQ_CONSUMER_QUEUE=service-tester  # Performance tester queue name

# ============================================================================
# Server Port Configuration
# ============================================================================

# Each service has its own dedicated port (defaults in service configs)
# SERVER_PORT is read by some services - set per-service if needed:
# - Bun: 8090
# - .NET 9 JIT: 8092
# - .NET 9 AOT: 8093
# - Go: 8094
# - Java 21 Quarkus GraalVM: 8096
# - Java 21 Spring Boot: 8097
# - Java 21 Spring Boot GraalVM: 8098
# - Python: 8099
# - Rust: 8100
# - Java 25 Spring Boot: 8101
# - Java 25 Spring Boot GraalVM: 8102
# - Java 25 Quarkus GraalVM: 8103

# ============================================================================
# MCP (Model Context Protocol) Configuration
# ============================================================================

# Context7 API Key for MCP server
# Get your API key from: https://context7.com
CONTEXT7_API_KEY=your-context7-api-key-here

# ============================================================================
# Notes
# ============================================================================

# Database Names (per service):
# - bun_db
# - dotnet9_db
# - dotnet9aot_db
# - go_db
# - python_db
# - rust_db
# - java21springboot_db
# - java21springbootgraal_db
# - java21quarkusgraal_db
# - java25springboot_db
# - java25springbootgraal_db
# - java25quarkusgraal_db

# Environment Variable Naming Conventions:
# - .NET services use double underscore: Postgres__Host, RabbitMQ__Host
# - Java services use uppercase: POSTGRES_HOST, RABBITMQ_HOST
# - Python/Go/Rust use standard: DB_HOST, RABBITMQ_HOST
# - Bash scripts use standard: POSTGRES_USER, RABBITMQ_USER

# All services support environment variable overrides while maintaining
# backwards compatibility with their default values.
